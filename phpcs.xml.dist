<?xml version="1.0"?>
<ruleset name="Content Gates" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/PHPCSStandards/PHP_CodeSniffer/master/phpcs.xsd">
	<description>WordPress and WPVIP coding standards for Content Gates.</description>

	<file>content-gates.php</file>
	<file>inc</file>
	<file>tests/unit</file>
	<file>tests/fixtures</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<!-- Verbatim upstream copy of WPVIP's Vary_Cache, loaded only in local environments. -->
	<exclude-pattern>*/inc/platform/vendor/*</exclude-pattern>
	<exclude-pattern>*/tests/phpstan/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg value="sp"/>
	<arg name="colors"/>
	<arg name="parallel" value="8"/>

	<config name="minimum_wp_version" value="7.0"/>
	<config name="testVersion" value="8.2-"/>

	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress-Docs"/>
	<rule ref="WordPress-VIP-Go"/>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="Automattic\VIP\ContentGates"/>
				<element value="content_gates"/>
				<element value="CONTENT_GATES"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="content-gates"/>
			</property>
		</properties>
	</rule>

	<!-- Tests simulate core: they fire core hooks, define core constants, and set reader cookies. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPressVIPMinimum.Variables.RestrictedVariables">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>

	<rule ref="WordPress.Files.FileName">
		<properties>
			<property name="strict_class_file_names" value="true"/>
		</properties>
		<!-- Test files follow the WordPress core `test-*.php` convention. -->
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
</ruleset>
