{
	"compilerOptions": {
		"target": "ES2022",
		"lib": [ "ES2022", "DOM" ],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noEmit": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"types": [],
		"paths": {
			"@wordpress/*": [ "./src/types/wordpress/*" ],
			"react/jsx-runtime": [ "./src/types/react-jsx-runtime" ]
		}
	},
	"include": [ "src" ]
}
