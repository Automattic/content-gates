{
	"name": "content-gates",
	"version": "0.1.0",
	"description": "Cache-aware content gating for WordPress on WPVIP.",
	"private": true,
	"license": "GPL-2.0-or-later",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"doctor": "node bin/doctor.mjs",
		"env": "wp-env",
		"env:tests": "wp-env --config=.wp-env.tests.json",
		"lint": "npm run lint:php && npm run analyze:php && npm run lint:js && npm run lint:contract",
		"lint:js": "wp-scripts lint-js",
		"lint:php": "composer lint",
		"analyze:php": "composer analyze",
		"test:php": "wp-env --config=.wp-env.tests.json run cli --env-cwd=wp-content/plugins/content-gates vendor/bin/phpunit",
		"test:e2e": "playwright test",
		"build": "wp-scripts build",
		"start": "wp-scripts start",
		"test:prepare-vip": "node bin/prepare-vip-test.mjs",
		"lint:contract": "node bin/audit-membership.mjs"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"@wordpress/api-fetch": "^7.57.0",
		"@wordpress/block-editor": "^18.1.0",
		"@wordpress/components": "^42.0.0",
		"@wordpress/compose": "^8.10.0",
		"@wordpress/e2e-test-utils-playwright": "^3.0.0",
		"@wordpress/element": "^9.0.0",
		"@wordpress/env": "^11.17.0",
		"@wordpress/hooks": "^4.57.0",
		"@wordpress/i18n": "^6.30.0",
		"@wordpress/scripts": "^36.1.0"
	}
}
